# syntax=docker/dockerfile:1
FROM python:3.12-slim
COPY requirements-redteam.txt /opt/requirements-redteam.txt
RUN --mount=type=secret,id=proxy_ca,target=/run/proxy-ca.pem,required=true \
    PIP_CERT=/run/proxy-ca.pem pip install --no-cache-dir -r /opt/requirements-redteam.txt
ENV HOME=/tmp SEMGREP_SEND_METRICS=off SEMGREP_ENABLE_VERSION_CHECK=0
USER 65534:65534
ENTRYPOINT ["semgrep"]
