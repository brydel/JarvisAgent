  "fixes": {
    "$description": "Jetons qui ne dépendent pas du thème, émis dans src/styles/tokens.css. Chaque groupe porte sa règle d'usage ; `mobile` et `mouvement-reduit` sont les valeurs de remplacement sous 760 px de large et sous prefers-reduced-motion.",
    "police": {
      "$description": "Trois familles, toutes sous SIL OFL 1.1, embarquées par @fontsource (aucune police distante). Interface : Instrument Sans. Grands titres seulement (28 px et plus) : Newsreader. Chiffres, durées, comptes, provenance, touches, code : IBM Plex Mono.",
      "font-sans": "\"Instrument Sans Variable\", \"Segoe UI Variable\", \"Segoe UI\", system-ui, sans-serif",
      "font-serif": "\"Newsreader Variable\", Georgia, \"Times New Roman\", serif",
      "font-mono": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace",
      "fw-regular": "400",
      "fw-medium": "500",
      "fw-strong": "600"
    },
    "taille": {
      "$description": "Échelle de l'interface (pixels écran) : taille et interligne vont par paire. Rien sous 12 px (11 px au plus petit en mobile). Deux graisses, 400 et 500 ; 600 pour le mot-symbole et la lettre de raccourci de la barre d'outils, rien d'autre. La hiérarchie vient de la taille et du rôle de texte. Interlettrage 0 sous 40 px. Chiffres : font-variant-numeric: tabular-nums.",
      "fs-meta": "12px",
      "lh-meta": "16px",
      "fs-sm": "13px",
      "lh-sm": "20px",
      "fs-base": "14px",
      "lh-base": "20px",
      "fs-lg": "16px",
      "lh-lg": "24px",
      "fs-xl": "18px",
      "lh-xl": "24px",
      "fs-2xl": "22px",
      "lh-2xl": "28px",
      "fs-figure": "28px",
      "lh-figure": "32px",
      "fs-title": "28px",
      "fs-title-lg": "36px",
      "lh-title": "1.15",
      "fs-display": "60px",
      "lh-display": "1.05",
      "tracking-display": "-0.02em",
      "measure": "36rem",
      "type-credit": "var(--fw-regular) var(--fs-meta)/var(--lh-meta) var(--font-mono)"
    },
    "taille-canevas": {
      "$description": "Échelle des cartes du Board, en unités du canevas : au zoom de référence (80 %) une unité vaut 0,8 px écran. 15 = 12 px écran, le plancher.",
      "fsc-meta": "15px",
      "fsc-sm": "16px",
      "fsc-base": "18px",
      "fsc-lg": "20px",
      "fsc-xl": "24px",
      "fsc-title": "30px"
    },
    "espace": {
      "$description": "Grille de 4 px : --space-N vaut N × 4 px. Marges, espacements et hauteurs fixes sont des multiples de 4 ; --space-half (2 px) ne sert qu'aux ajustements à l'intérieur d'un petit contrôle. Dans un contrôle : 4 à 12. Entre éléments liés : 2 à 8. Entre groupes : 12 à 24. Entre sections : 32 à 64.",
      "space-half": "2px",
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "20px",
      "space-6": "24px",
      "space-8": "32px",
      "space-10": "40px",
      "space-12": "48px",
      "space-16": "64px",
      "space-20": "80px",
      "space-24": "96px",
      "pad-control": "var(--space-3)",
      "pad-panel": "var(--space-4)",
      "pad-card": "var(--space-5)",
