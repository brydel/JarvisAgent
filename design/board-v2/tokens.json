{
  "$description": "Jarvis Board V2 — jetons de design. Couleurs mesurées sur design/references/JARVIS_BOARD_V2_REFERENCE.png (moyenne 3×3, scripts/echantillons.mjs) puis stabilisées. Source unique : studio/board-v2/src/styles/tokens.css les reprend à l'identique.",
  "color": {
    "bg": { "app": "#0B0E15", "bar": "#0E1119", "canvas": "#0D1018", "grid-dot": "#232838" },
    "surface": { "card": "#121621", "card-raised": "#161B28", "panel": "#121722", "inset": "#0F131C", "hover": "#1A2031" },
    "border": { "subtle": "#1E2433", "card": "#252B3B", "strong": "#323A50" },
    "text": { "primary": "#E8EAF2", "secondary": "#A1A7B8", "muted": "#6E7587", "inverse": "#0B0E15" },
    "brand": { "indigo": "#5B6CFF", "indigo-strong": "#4E63FC", "indigo-soft": "#7E8BFF", "cobalt": "#3D5AFE" },
    "accent": { "cyan": "#22D3EE", "violet": "#A855F7", "magenta": "#C026D3", "green": "#34D399" },
    "semantic": { "success": "#3FB984", "success-bg": "#12382A", "warning": "#E5B53D", "warning-bg": "#3A2F12", "danger": "#E5486F", "danger-bg": "#3A1323", "info": "#60A5FA" },
    "priority": { "p1": "#E0457B", "p1-bg": "#3B1426", "p2": "#E2B93B", "p2-bg": "#3A3012", "p3": "#3FB984", "p3-bg": "#12382A" },
    "edge": { "inspire": "#B26BF5", "alimente": "#3FCF9A", "utilise": "#38BDF8", "default": "#5B6CFF" }
  },
  "font": {
    "family": { "sans": "Inter Variable, Inter, 'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif" },
    "size": { "xs": 11, "sm": 12, "md": 13, "base": 14, "lg": 16, "xl": 18, "2xl": 22 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "numeric": "tabular-nums"
  },
  "space": { "base": 4, "scale": [0, 4, 8, 12, 16, 20, 24, 32] },
  "radius": { "xs": 6, "sm": 8, "card": 12, "panel": 14, "pill": 999 },
  "shadow": {
    "card": "0 1px 0 rgba(255,255,255,0.03) inset, 0 8px 24px rgba(0,0,0,0.35)",
    "lift": "0 16px 40px rgba(0,0,0,0.5)",
    "mission-glow": "0 0 0 1px rgba(91,108,255,0.55), 0 0 28px rgba(76,110,255,0.35)",
    "selection": "0 0 0 2px #5B6CFF, 0 0 18px rgba(91,108,255,0.45)"
  },
  "motion": {
    "duration": { "hover": 140, "appear": 180, "panel": 220, "drag-lift": 120 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" },
    "rule": "transform et opacity seulement ; aucune animation perpétuelle sur les cartes ; prefers-reduced-motion respecté"
  },
  "layout": {
    "reference": { "width": 1672, "height": 941, "canvasZoom": 0.8 },
    "topbar": { "height": 56 },
    "subbar": { "height": 64 },
    "toolbar": { "x": 16, "width": 68, "itemHeight": 66 },
    "panel": { "width": 368 },
    "minimap": { "width": 124, "height": 92 }
  }
