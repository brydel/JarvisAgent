#!/usr/bin/env bash
# jarvis — commandes courtes pour piloter les agents IA (Claude Code, Codex)
# au-dessus de tmux + workmux, avec Linear comme canal de tâches.

set -euo pipefail

JARVIS_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
SESSION="${JARVIS_SESSION:-jarvis}"

C_CYAN=$'\033[36m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_OFF=$'\033[0m'
ok()   { printf '  %s✓%s %s\n' "$C_GREEN" "$C_OFF" "$1"; }
warn() { printf '  %s!%s %s\n' "$C_YELLOW" "$C_OFF" "$1"; }
bad()  { printf '  %s✗%s %s\n' "$C_RED" "$C_OFF" "$1"; }
die()  { printf '%sErreur :%s %s\n' "$C_RED" "$C_OFF" "$1" >&2; exit 1; }
# Sous WSL, ignorer les programmes Windows (/mnt/c/...) : ils ne marchent pas dans Linux.
has()  { local p; p="$(command -v "$1" 2>/dev/null)" || return 1; [[ "$p" != /mnt/* ]]; }

# Guillemets simples sûrs pour une ligne de commande tmux (indépendant de la locale et du shell).
squote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# Sous-commandes écrites en Python (lib/jarvis), bibliothèque standard uniquement.
py() { PYTHONPATH="$JARVIS_HOME/lib${PYTHONPATH:+:$PYTHONPATH}" python3 -m jarvis "$@"; }

usage() {
  cat <<EOF
${C_CYAN}jarvis${C_OFF} — l'usine : des agents IA spécialisés, pilotés par un chef d'orchestre

${C_CYAN}Pilotage${C_OFF}
  jarvis start [--fond]                 Ouvre la session « $SESSION » : cockpit + démon
                                        (après un redémarrage : reprend les agents et le chef)
  jarvis chef                           Lance (ou rejoint) le chef d'orchestre
  jarvis cockpit                        Interface plein écran (ateliers, plans, livrables, fil)
  jarvis web                            Tableau de bord dans le navigateur (lecture seule)
  jarvis etat · jarvis usine            État complet · les ateliers : qui travaille sur quoi
  jarvis plan liste|voir|ok|non         Plans proposés par le chef
  jarvis fil [n]                        Derniers événements

${C_CYAN}Agents${C_OFF}
  jarvis task [--projet P] <ISSUE> <claude|codex|auto> [desc] [--role R] [--taille S|M|L]
              [--modele M] [--consignes fichier.md] [--revue N°PR]
                                        Lance un agent spécialisé sur une issue Linear, dans son worktree
  jarvis voir <projet:worktree>         Sortie récente d'un agent (même non suivi par workmux)
  jarvis fermer <projet:worktree>|--termines
                                        Ferme la fenêtre d'agents terminés (worktree conservé)
  jarvis reprendre [--essai]            Relance les agents interrompus par un redémarrage (même admission)
  jarvis lourd debut|fin|exec|liste     Déclare une opération lourde (compilation, tests, navigateur, vidéo)
  jarvis tache [n] · jarvis bilan       Registre des tâches · ce que l'usine a produit
  jarvis tache voir|echec <T-…>         Détail d'une tâche (essais, échec, jetons) · classer un échec
  jarvis tache relancer <T-…> --autoriser
                                        Débloquer un essai de plus après une escalade (toi seulement)
  jarvis bilan quotidien                Le bilan du matin (aussi envoyé sur Telegram à 08:00)
  jarvis cout [tache <T>|projet <P>]    Équivalent API des tâches (pas une dépense : tu es à l'abonnement)
  jarvis budget-jetons voir <T-…>       Jetons consommés par une unité de travail face à son plafond
  jarvis memoire noter|chercher|liste   Mémoire du chef : décisions, échecs, leçons, recherche pondérée
  jarvis rejouer <T-…>                  Chronologie d'une tâche (plan, admission, tours, verdict, fin)
  jarvis rollback proposer|demander <T> Défaire par revert les commits d'une tâche (bouton Revert sur Telegram)
  jarvis traces [exporter|envoyer]      Dernières exécutions (jetons, durée, coût) · export OpenTelemetry
  jarvis eval liste|verifier|lancer     Harnais d'évaluation des rôles (cas fixes jugés par scripts)
  jarvis skill auditer|installer <src>  Registre des skills : épinglage, quarantaine, approbation (toi)
  jarvis role candidats|proposer        Briefs candidats : essai sur 10 % des tâches après ton accord
  jarvis stockage etat|migrer|revenir   État en JSON (défaut) ou SQLite, migration vérifiée
  jarvis executant liste                Exécutants déclarés et bail d'orchestrateur (un seul démon)
  jarvis verdict <projet> <ISSUE> pret|corrections [note]
                                        Verdict d'une contre-relecture
  jarvis board · jarvis status          Tableau de bord workmux · tâches du projet courant

${C_CYAN}Rôles et modèles${C_OFF}
  jarvis role [voir <nom>]              Les spécialités de l'usine (DevOps, front-end, vidéo…)
  jarvis modele                         Catalogue des modèles et leur disponibilité
  jarvis modele choisir --role R [--taille M]
                                        Ce que le routeur choisirait, et pourquoi
  jarvis modele verifier                Essaie chaque modèle avec tes abonnements
  jarvis modele ok|non M-0001           Accepter ou refuser une proposition du chef
  jarvis jetons                         Consommation Claude et Codex, rythme et prévision

${C_CYAN}Studio${C_OFF}
  jarvis studio verifier <fichier>      Contrôle technique d'une vidéo + planche-contact
  jarvis livrer <fichier> [--titre T] [--legende L]
                                        Contrôle un livrable puis te l'envoie sur Telegram
  jarvis livrables [<projet> <ISSUE>]   Livrables récents, ou dossier d'une issue

${C_CYAN}Réglages${C_OFF}
  jarvis projet ajouter <nom> <chemin> [--linear X] [--priorite 1] [--description "…"]
  jarvis projet liste
  jarvis telegram config|test           Relier Jarvis à ton téléphone
  jarvis regler <clé> <valeur>          ex. general.max_agents 3
  jarvis veille [fait <projet>]         Veille concurrentielle par projet
  jarvis init-project [dossier]         Ajoute AGENTS.md + CLAUDE.md (protocole Linear)
  jarvis doctor                         Vérifie que tout est installé et connecté
  jarvis relancer [--chef]              Après une mise à jour : relance démon et cockpit (et le chef)

${C_CYAN}Autonomie et garde-fous${C_OFF}
  jarvis pause [poser|lever <cause>]    Pauses indépendantes : humain, batterie, quota, ressources, incident, maintenance
  jarvis admission etat                 Réservations et opérations lourdes en cours (point d'admission commun)
  jarvis politique [verifier <action>]  Politique de délégation : ce qui est automatique, délégué ou à approuver
  jarvis budget [definir …]             Enveloppes de dépense (non renseignée = zéro)
  jarvis fournisseurs                   Capacités déclarées de Claude et Codex (modèles, quotas, fraîcheur)
  jarvis audit [n] [--verifier]         Journal d'audit des décisions (chaîne d'empreintes)

${C_CYAN}Poste${C_OFF}
  jarvis sante                          Mémoire, disque, Docker, batterie, redémarrage Windows
  jarvis diagnostic                     Inventaire léger du poste (WSL vs Windows), rapport expurgé
  jarvis secrets verifier --projet P    Variables secrètes que recevrait chaque rôle (noms seuls)
  jarvis profil [appliquer <nom>]       Profils : laptop-conservative, workstation
  jarvis autostart installer|retirer|etat
                                        Démarrer Jarvis tout seul à l'ouverture de session Windows
  jarvis reparer-git <projet>           Répare le dépôt après un arrêt brutal (sauvegarde d'abord)

Exemples :
  jarvis task --projet repriceo BIS-82 auto auth-avancee --role backend --taille L
  jarvis plan ok P-0003
EOF
}

require_git_repo() {
  git rev-parse --show-toplevel >/dev/null 2>&1 \
    || die "lance cette commande depuis le dossier d'un projet git (ex. cd ~/projets/repriceo)."
}

slugify() {
  # Une substitution par lettre accentuée : les classes [éè] cassent sur l'UTF-8.
  printf '%s' "$1" \
    | sed -e 's/À/a/g; s/Â/a/g; s/à/a/g; s/â/a/g; s/ä/a/g' \
          -e 's/É/e/g; s/È/e/g; s/Ê/e/g; s/é/e/g; s/è/e/g; s/ê/e/g; s/ë/e/g' \
          -e 's/Î/i/g; s/î/i/g; s/ï/i/g; s/Ô/o/g; s/ô/o/g; s/ö/o/g' \
          -e 's/Ù/u/g; s/Û/u/g; s/ù/u/g; s/û/u/g; s/ü/u/g; s/Ç/c/g; s/ç/c/g' \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//'
}

ensure_window() {  # ensure_window <nom> <commande>
  tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$1" \
    || tmux new-window -d -t "$SESSION:" -n "$1" "$2"
}

FRESH_SESSION=0
REPRISE_INFO=""

ensure_session() {
  has tmux || die "tmux n'est pas installé (lance ./install.sh)."
  local jarvis="$JARVIS_HOME/bin/jarvis"
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    FRESH_SESSION=1
    # Avant le démon (qui réécrirait l'instantané) : agents interrompus par un redémarrage ?
    REPRISE_INFO="$(py reprise-preparer 2>/dev/null || true)"
    tmux new-session -d -s "$SESSION" -n cockpit -c "$HOME" "$jarvis cockpit; exec bash"
  fi
  # Les suggestions de prochaine commande de Claude Code n'ont aucun sens pour un agent
  # et brouillent la lecture de son écran : désactivées pour toutes les fenêtres Jarvis.
  tmux set-environment -g CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION false
  ensure_window cockpit "$jarvis cockpit; exec bash"
  # Le démon est relancé s'il s'arrête sur une erreur ; Ctrl+C (code 0) l'arrête pour de bon.
  ensure_window daemon "until $jarvis daemon; do echo '⚠ démon arrêté sur une erreur : relance dans 5 s (Ctrl+C pour annuler)'; sleep 5; done; exec bash"
}

# Après un redémarrage : relance les agents qui travaillaient, puis le chef s'il tournait.
resume_after_reboot() {
  ((FRESH_SESSION)) && [[ -n "$REPRISE_INFO" ]] || return 0
  local jarvis="$JARVIS_HOME/bin/jarvis" agents chef
  agents="$(sed -n 's/.*"agents": \([0-9]*\).*/\1/p' <<<"$REPRISE_INFO")"
  chef="$(sed -n 's/.*"chef": \(true\|false\).*/\1/p' <<<"$REPRISE_INFO")"
  if [[ "$(py reglage-lire general.reprise_auto)" != "true" ]]; then
    warn "Redémarrage détecté : ${agents:-0} agent(s) interrompu(s). Relance-les avec « jarvis reprendre »."
    return 0
  fi
  if [[ "${agents:-0}" -gt 0 ]]; then
    printf '%s↻%s Redémarrage détecté : reprise de %s agent(s)…\n' "$C_CYAN" "$C_OFF" "$agents"
    # workmux open doit tourner DANS tmux : petite fenêtre temporaire, attendue au plus 3 min.
    tmux new-window -d -t "$SESSION:" -n reprise \
      "$jarvis reprendre; tmux wait-for -S jarvis-reprise-$$; sleep 5"
    timeout 180 tmux wait-for "jarvis-reprise-$$" || warn "reprise des agents encore en cours (fenêtre « reprise »)"
  else
    py reprendre >/dev/null 2>&1 || true  # rien à rouvrir, mais le chef doit être informé
  fi
  [[ "$chef" == "true" ]] && start_chef
  return 0
}

attach_to() {  # attach_to [fenêtre]
  local target="$SESSION${1:+:$1}"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$target" 2>/dev/null || tmux select-window -t "$target"
  else
    exec tmux attach -t "$target"
  fi
}

cmd_start() {
  local fond=0
  [[ "${1:-}" == "--fond" ]] && fond=1
  ensure_session
  resume_after_reboot
  ((fond)) && { ok "Jarvis tourne en arrière-plan (session « $SESSION »)."; return 0; }
  attach_to cockpit
}

cmd_chef() {
  has claude || die "Claude Code n'est pas installé (lance ./install.sh)."
  ensure_session
  resume_after_reboot
  start_chef
  attach_to chef
}

# Après une mise à jour de JarvisAgent (git pull) : relance le démon et le cockpit avec le nouveau
# code, sans toucher aux agents. Avec --chef, relance aussi le chef (nouveau rôle, nouvelles permissions).
cmd_relancer() {
  local avec_chef=0 w
  [[ "${1:-}" == "--chef" ]] && avec_chef=1
  has tmux || die "tmux n'est pas installé (lance ./install.sh)."
  tmux has-session -t "$SESSION" 2>/dev/null || { cmd_start --fond; return 0; }
  # Pause « maintenance » le temps de la relance : aucun lancement ne part pendant que le démon
  # change de version. Levée à la fin ; si la relance casse, « jarvis pause lever maintenance ».
  local maintenance_posee=0
  if py pause poser maintenance "relance de Jarvis" 2>/dev/null | grep -q "⏸"; then maintenance_posee=1; fi
  # Les anciennes fenêtres sont renommées, les nouvelles créées, puis les anciennes fermées :
  # la session ne reste jamais vide, même si elle ne contenait que ces deux fenêtres.
  for w in daemon cockpit; do
    tmux rename-window -t "$SESSION:$w" "ancien-$w" 2>/dev/null || true
  done
  ensure_session
  for w in daemon cockpit; do
    tmux kill-window -t "$SESSION:ancien-$w" 2>/dev/null || true
  done
  # Le cockpit reprend la première place : « Ctrl+B puis 1 » y ramène toujours.
  tmux swap-window -d -s "$SESSION:cockpit" -t "$SESSION:{start}" 2>/dev/null || true
  ok "Démon et cockpit relancés avec la version installée."
  if chef_present; then
    if ((avec_chef)); then
      tmux kill-window -t "$SESSION:chef" 2>/dev/null || true
      start_chef
    else
      py chef-preparer >/dev/null   # permissions à jour ; son rôle, lui, n'est relu qu'au démarrage
      warn "Le chef garde son ancien rôle jusqu'à son prochain démarrage : jarvis relancer --chef"
    fi
  fi
  # Levée seulement si c'est nous qui l'avions posée : une maintenance décidée par toi reste en place.
  ((maintenance_posee)) && { py pause lever maintenance >/dev/null 2>&1 || true; }
  return 0
}

# Lance le chef sans s'y attacher (utilisé par le démon quand le chef s'est arrêté).
cmd_chef_lancer() {
  has claude || die "Claude Code n'est pas installé."
  tmux has-session -t "$SESSION" 2>/dev/null || die "session « $SESSION » fermée (jarvis start)."
  start_chef
}

# Vrai si une fenêtre « chef » existe. Si Claude Code s'y est arrêté (il ne reste qu'un shell), la
# fenêtre est fermée d'abord : y écrire exécuterait les messages comme des commandes.
chef_present() {
  local rc=0
  py chef-etat >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) return 0 ;;
    2) warn "Le chef s'était arrêté (fenêtre restée sur un shell) : je la referme et je le relance."
       tmux kill-window -t "$SESSION:chef" 2>/dev/null || true
       return 1 ;;
    *) return 1 ;;
  esac
}

start_chef() {
  has claude || { warn "Claude Code introuvable : chef non lancé."; return 0; }
  if ! chef_present; then
    local dir flags="" kickoff mode
    dir="$(py chef-preparer)"
    kickoff="$(py chef-message)"
    mode="$(py reglage-lire general.chef_permission_mode)"
    case "$mode" in
      ""|default|manual|plan|auto|acceptEdits) ;;
      *) die "general.chef_permission_mode « $mode » refusé : le chef ne peut pas contourner ses permissions." ;;
    esac
    [[ -n "$mode" ]] && flags+=" --permission-mode $mode"
    if [[ "$(py reglage-lire general.chef_remote_control)" == "true" ]]; then
      flags+=" --remote-control JARVIS-CHEF"
    fi
    # JARVIS_ROLE=chef : « jarvis task » exigera alors un plan approuvé.
    tmux new-window -d -t "$SESSION:" -n chef -c "$dir" \
      "env JARVIS_ROLE=chef CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false claude$flags $(squote "$kickoff"); exec bash"
    py evenement chef "chef d'orchestre démarré"
    ok "Chef lancé dans la fenêtre « chef ». Il va proposer un premier plan."
  fi
}

cmd_task() {
  local projet="" plan="" consignes="" revue="" role="" modele="" taille=""
  local -a pos=()
  while (($#)); do
    case "$1" in
      --projet)    projet="${2:?--projet attend un nom}"; shift 2 ;;
      --plan)      plan="${2:?--plan attend un ID (P-0001)}"; shift 2 ;;
      --consignes) consignes="${2:?--consignes attend un fichier}"; shift 2 ;;
      --revue)     revue="${2:?--revue attend un numéro de PR}"; shift 2 ;;
      --role)      role="${2:?--role attend un nom (jarvis role liste)}"; shift 2 ;;
      --modele)    modele="${2:?--modele attend un nom (jarvis modele liste)}"; shift 2 ;;
      --taille)    taille="${2:?--taille attend S, M ou L}"; shift 2 ;;
      -*)          die "option inconnue : $1" ;;
      *)           pos+=("$1"); shift ;;
    esac
  done
  set -- "${pos[@]+"${pos[@]}"}"
  [[ $# -ge 2 ]] || die "usage : jarvis task [--projet P] [--plan ID] <ISSUE> <claude|codex|auto> [desc] [--role R] [--taille S|M|L] [--modele M] [--consignes f.md] [--revue N°PR]"
  [[ -z "$revue" || "$revue" =~ ^[0-9]+$ ]] || die "--revue attend un numéro de PR (ex. 123)."
  local issue="$1" who="$2" desc="${3:-}"
  [[ "$issue" =~ ^[A-Za-z]+-[0-9]+$ ]] || die "« $issue » ne ressemble pas à un ID Linear (ex. BIS-82)."
  issue="$(printf '%s' "$issue" | tr '[:lower:]' '[:upper:]')"
  case "$who" in
    claude|cc) who="claude" ;;
    codex|cx)  who="codex" ;;
    auto)      ;;
    *) die "agent inconnu « $who » : choisis claude, codex ou auto." ;;
  esac

  # Les chemins relatifs se résolvent AVANT d'entrer dans le dossier du projet.
  if [[ -n "$consignes" ]]; then
    [[ -f "$consignes" ]] || die "fichier de consignes introuvable : $consignes"
    consignes="$(readlink -f "$consignes")"
  fi

  # Seul un humain devant un vrai terminal peut lancer hors plan. Un agent (chef compris)
  # n'a pas de terminal interactif : il lui faut un plan approuvé, quel que soit son environnement.
  local guarded=0
  if [[ "${JARVIS_ROLE:-}" == "chef" || ! ( -t 0 && -t 1 ) || -n "$plan" ]]; then
    guarded=1
    [[ -n "$plan" ]] || die "aucun lancement automatique sans plan approuvé : ajoute --plan P-xxxx."
    [[ -n "$projet" ]] || die "avec un plan, précise le projet : --projet <nom>."
    [[ -z "$role$modele$taille" ]] || warn "--role, --modele et --taille sont ignorés : le plan approuvé fait foi."
  fi

  local path=""
  if [[ -n "$projet" ]]; then
    path="$(py projet chemin "$projet")" || exit 1
    cd "$path" || die "dossier du projet introuvable : $path"
  fi

  require_git_repo
  has workmux || die "workmux n'est pas installé (lance ./install.sh)."
  [[ -n "${TMUX:-}" ]] || die "lance d'abord « jarvis start », puis cette commande dans la session."

  local root
  root="$(git rev-parse --show-toplevel)"
  [[ "$(readlink -f "$root")" != "$(readlink -f "$JARVIS_HOME")" ]] \
    || die "tu es dans le dépôt JarvisAgent. Va d'abord dans ton projet (ex. cd ~/projets/repriceo)."
  if [[ -n "$path" && "$(readlink -f "$root")" != "$(readlink -f "$path")" ]]; then
    die "le projet « $projet » est enregistré sur $path, mais ce dossier appartient au dépôt $root."
  fi
  [[ -n "$projet" ]] || projet="$(basename "$root")"

  local branch
  branch="$(slugify "$issue")"
  [[ -n "$desc" ]] && branch="$branch-$(slugify "$desc")"
  [[ -n "$revue" && "$branch" != *revue* ]] && branch="$branch-revue-pr-$revue"

  # Affectation : fournisseur, modèle, effort et rôle. Tout départ passe par l'admission commune
  # (pauses, observation, capacité + réservations, opérations lourdes, doublons, jetons) :
  #  - avec un plan : l'affectation validée par l'humain, marquée lancée sous le même verrou ;
  #  - à la main : réservation d'abord, puis le routeur choisit selon le rôle, la taille et les jetons.
  # Empreinte des consignes : un 2e essai après un échec doit changer d'approche (modèle ou consignes).
  local empreinte=""
  [[ -n "$consignes" ]] && empreinte="$(sha256sum "$consignes" | cut -c1-16)"
  local fiche reservation=""
  if ((guarded)); then
    fiche="$(py plan verifier "$plan" "$projet" "$issue" "$who" --worktree "$branch" --consignes-empreinte "$empreinte" ${revue:+--revue})" || exit $?
  else
    [[ -n "$revue" && -z "$role" ]] && role="revue"
    local admis
    admis="$(py admission demander "$projet" "$issue" "$who" --origine cli --worktree "$branch" --role "$role" \
             --taille "${taille:-M}" --consignes-empreinte "$empreinte")" || exit $?
    reservation="$(sed -n 's/^reservation=//p' <<<"$admis")"
    local -a choix=(--shell --agent "$who" --taille "${taille:-M}")
    [[ -n "$role" ]] && choix+=(--role "$role")
    [[ -n "$modele" ]] && choix+=(--modele "$modele")
    [[ -n "$revue" && "$who" == "auto" ]] && choix+=(--relit "$projet:$issue")
    fiche="$(py modele choisir "${choix[@]}")" || { py admission liberer "$reservation" "routeur en échec" >/dev/null || true; exit 1; }
    fiche+=$'\n'"reservation=$reservation"$'\n'"classe=$(sed -n 's/^classe=//p' <<<"$admis")"
    fiche+=$'\n'"jetons_max=$(sed -n 's/^jetons_max=//p' <<<"$admis")"
  fi
  local -A F=()
  local cle valeur
  while IFS='=' read -r cle valeur; do
    [[ -n "$cle" ]] && F["$cle"]="$valeur"
  done <<<"$fiche"
  who="${F[agent]:-}"
  reservation="${F[reservation]:-$reservation}"

  # Annule proprement un lancement qui n'aboutit pas : réservation rendue, la tâche redevient lançable
  # dans son plan. Défini ici : tout échec après l'admission doit passer par là.
  local tache_id="" prompt_file=""
  abandon() {  # abandon <message>
    [[ -n "$prompt_file" ]] && rm -f "$prompt_file"
    [[ -n "$tache_id" ]] && py tache-annuler "$tache_id" || true
    [[ -n "$reservation" ]] && py admission liberer "$reservation" "$1" >/dev/null || true
    ((guarded)) && py plan relacher "$plan" "$projet" "$issue" "$who" || true
    py evenement erreur "échec du lancement de $issue ($who) sur $projet"
    die "$1"
  }

  local agent rules
  case "$who" in
    claude) agent="cc"; rules="CLAUDE.md" ;;
    codex)  agent="cx"; rules="AGENTS.md" ;;
    *) abandon "affectation illisible pour $issue (agent « $who »)." ;;
  esac
  [[ -f "$root/$rules" ]] || warn "$rules absent de ce projet : lance « jarvis init-project » pour ajouter le protocole Linear."

  prompt_file="$(mktemp --suffix=.md)"
  local brief_file
  brief_file="$(mktemp)"
  local -a pargs=(--projet "$projet" --issue "$issue" --branche "$branch" --regles "$rules" --role "${F[role]:-}"
                  --brief-sortie "$brief_file")
  [[ -n "$revue" ]] && pargs+=(--revue "$revue")
  [[ -n "$consignes" ]] && pargs+=(--consignes "$consignes")
  py prompt-construire "${pargs[@]}" >"$prompt_file" || abandon "impossible de préparer le prompt de l'agent."

  # Pré-accepter la confiance du futur worktree : l'agent démarre sans poser de question.
  # (Emplacement par défaut de workmux : <projet>/../<projet>__worktrees/<branche>.)
  local wt_path
  wt_path="$(dirname "$root")/$(basename "$root")__worktrees/$branch"
  py preparer-worktree "$who" "$wt_path" >/dev/null || warn "impossible de pré-autoriser $wt_path"

  # Fiche du registre : les lanceurs (jarvis-claude, jarvis-codex) y lisent le modèle du worktree,
  # et le cockpit le rôle de l'agent.
  local -a targs=(--projet "$projet" --issue "$issue" --agent "$who" --worktree "$branch" --chemin "$wt_path"
                  --role "${F[role]:-}" --modele "${F[modele]:-}" --modele-id "${F[modele_id]:-}"
                  --effort "${F[effort]:-}" --repli "${F[repli]:-}" --taille "${F[taille]:-M}"
                  --plan "$plan" --revue "$revue" --raison "${F[raison]:-}"
                  --classe "${F[classe]:-}" --reservation "$reservation"
                  --jetons-max "${F[jetons_max]:-}" --consignes-empreinte "$empreinte")
  [[ "${F[par_secours]:-0}" == "1" ]] && targs+=(--secours)
  # Version du brief réellement mise dans le prompt (stable ou candidat en essai).
  [[ -s "$brief_file" ]] && targs+=(--brief "$(cat "$brief_file")")
  rm -f "$brief_file"
  # Point de départ de la branche (workmux la crée depuis le dépôt principal) : base exacte d'un rollback.
  local base_sha
  base_sha="$(git -C "$root" rev-parse HEAD 2>/dev/null || true)"
  [[ -n "$base_sha" ]] && targs+=(--base "$base_sha")
  tache_id="$(py tache-enregistrer "${targs[@]}")" || abandon "impossible d'enregistrer la tâche."

  local affiche="$who"
  [[ -n "${F[modele]:-}" && "${F[modele]}" != *-defaut ]] && affiche+=" · ${F[modele]}"
  [[ -n "${F[effort]:-}" ]] && affiche+=" · ${F[effort]}"
  printf '%s▶%s %s → %s [%s] (branche %s)\n' "$C_CYAN" "$C_OFF" "$issue" "$affiche" "${F[role]:-generaliste}" "$branch"
  [[ "${F[par_secours]:-0}" == "1" ]] && warn "lancé avec le secours : le fournisseur prévu est épuisé."
  # Backend d'exécution du projet (workmux par défaut, sur ce PC ; voir lib/jarvis/execution.py).
  if ! py execution lancer --projet "$projet" --branche "$branch" --agent "$agent" --prompt "$prompt_file" \
       --reservation "$reservation"; then
    abandon "le lancement de l'agent a échoué."
  fi
  # Le fichier de prompt reste dans /tmp : workmux peut le relire au démarrage de l'agent.
  py evenement task "$projet $issue lancé → $affiche [${F[role]:-generaliste}]${plan:+ ($plan)}"
  ok "Agent lancé en arrière-plan. Suis-le dans le cockpit (jarvis cockpit)."
}

cmd_board()  { has workmux || die "workmux n'est pas installé."; exec workmux dashboard "$@"; }
cmd_status() { has workmux || die "workmux n'est pas installé."; exec workmux list "$@"; }

cmd_init_project() {
  local dir="${1:-.}"
  [[ -d "$dir" ]] || die "dossier introuvable : $dir"
  dir="$(cd "$dir" && pwd)"
  local f
  for f in AGENTS.md CLAUDE.md; do
    if [[ -e "$dir/$f" ]]; then
      warn "$f existe déjà dans $dir : je n'y touche pas (compare avec $JARVIS_HOME/templates/$f)."
    else
      cp "$JARVIS_HOME/templates/$f" "$dir/$f"
      ok "$f ajouté"
    fi
  done
  echo
  echo "Adapte la section « Projet » des deux fichiers, puis commite-les sur main :"
  echo "  git add AGENTS.md CLAUDE.md && git commit -m \"chore: protocole des agents\" && git push"
}

# --- Démarrage automatique (Windows + WSL) -------------------------------------------

startup_file() {
  local appdata
  appdata="$(cmd.exe /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r')" || return 1
  [[ -n "$appdata" && "$appdata" != "%APPDATA%" ]] || return 1
  printf '%s/Microsoft/Windows/Start Menu/Programs/Startup/jarvis-agent.vbs' "$(wslpath -u "$appdata")"
}

cmd_autostart() {
  local action="${1:-etat}" file distro
  [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/version 2>/dev/null \
    || die "le démarrage automatique ne concerne que Windows + WSL."
  file="$(startup_file)" || die "impossible de trouver le dossier Démarrage de Windows (cmd.exe introuvable ?)."
  distro="${WSL_DISTRO_NAME:-Ubuntu}"
  case "$action" in
    installer)
      # wscript lance wsl.exe sans fenêtre ; « sleep infinity » garde WSL (et donc tmux) en vie.
      local cmd="$JARVIS_HOME/bin/jarvis start --fond; exec sleep infinity"
      printf '%s\r\n' \
        "' JarvisAgent - demarrage automatique (cree par: jarvis autostart installer)" \
        "' Pour l'arreter : jarvis autostart retirer (ou supprime ce fichier)" \
        "CreateObject(\"WScript.Shell\").Run \"wsl.exe -d $distro -- bash -lic \"\"$cmd\"\"\", 0, False" \
        >"$file"
      ok "Démarrage automatique installé : à chaque ouverture de session Windows, Jarvis repart tout seul."
      echo "  Fichier : $file"
      echo "  Pense aussi à Docker Desktop → Settings → General → « Start Docker Desktop when you sign in »."
      ;;
    retirer)
      rm -f "$file" && ok "Démarrage automatique retiré." ;;
    etat)
      if [[ -f "$file" ]]; then ok "Démarrage automatique actif ($file)"; else warn "Démarrage automatique non installé (jarvis autostart installer)"; fi ;;
    *) die "usage : jarvis autostart installer|retirer|etat" ;;
  esac
}

cmd_doctor() {
  local errors=0
  printf '%sOutils%s\n' "$C_CYAN" "$C_OFF"
  local t
  local v
  for t in git tmux gh node claude codex workmux; do
    if has "$t"; then
      if [[ "$t" == tmux ]]; then v="$(tmux -V 2>/dev/null || true)"; else v="$("$t" --version 2>/dev/null | head -1 || true)"; fi
      ok "${v:-$t}"
    elif [[ "$(command -v "$t" 2>/dev/null)" == /mnt/* ]]; then
      bad "$t pointe vers la version Windows ($(command -v "$t")) : relance ./install.sh"; errors=$((errors + 1))
    else
      bad "$t manquant"; errors=$((errors + 1))
    fi
  done

  printf '\n%sEmplacement%s\n' "$C_CYAN" "$C_OFF"
  if [[ "$PWD" == /mnt/* ]]; then
    warn "Tu es sur le disque Windows ($PWD) : travaille plutôt dans ~/projets."
  else
    ok "Dossier Linux ($PWD)"
  fi

  printf '\n%sConfigurations%s\n' "$C_CYAN" "$C_OFF"
  [[ -L "$HOME/.tmux.conf" ]] && ok "~/.tmux.conf lié à JarvisAgent" || warn "~/.tmux.conf n'est pas celui de JarvisAgent"
  [[ -L "$HOME/.config/workmux/config.yaml" ]] && ok "config workmux liée à JarvisAgent" || warn "config workmux absente ou personnalisée"

  printf '\n%sConnexions%s\n' "$C_CYAN" "$C_OFF"
  if has gh; then gh auth status >/dev/null 2>&1 && ok "GitHub connecté" || { bad "GitHub non connecté (gh auth login)"; errors=$((errors + 1)); }; fi
  if has claude; then
    claude mcp get linear-server >/dev/null 2>&1 && ok "Claude Code ↔ Linear" || warn "Claude Code n'a pas Linear (voir README, étape Linear)"
  fi
  if has codex; then
    codex mcp get linear >/dev/null 2>&1 && ok "Codex ↔ Linear" || warn "Codex n'a pas Linear (voir README, étape Linear)"
  fi

  printf '\n%sSuperagent%s\n' "$C_CYAN" "$C_OFF"
  if python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    ok "Python $(python3 -c 'import platform; print(platform.python_version())')"
  else
    bad "Python 3.11 ou plus requis"; errors=$((errors + 1))
  fi
  local nproj
  nproj="$(py projet liste 2>/dev/null | grep -c '^P[0-9]' || true)"
  ((nproj > 0)) && ok "$nproj projet(s) enregistré(s)" || warn "aucun projet : jarvis projet ajouter <nom> <chemin>"
  [[ "$(py reglage-lire telegram.chat_id)" != "" ]] && ok "Telegram relié" || warn "Telegram non relié (jarvis telegram config)"

  printf '\n%sAutonomie de Codex%s\n' "$C_CYAN" "$C_OFF"
  if has codex; then
    local res
    res="$("$JARVIS_HOME/bin/jarvis-codex" --tester-commit 2>&1 | tail -1)" || true
    case "$res" in
      OK*)     ok "Codex peut committer depuis un worktree (bac à sable)" ;;
      COMPLET*) ok "Codex en mode complet (sans bac à sable)" ;;
      INCONNU*) warn "test du bac à sable impossible avec cette version de Codex" ;;
      *)       warn "Codex ne peut pas committer dans son bac à sable : ${res#ECHEC }"
               echo "     Solution : jarvis regler codex.mode complet" ;;
    esac
  fi

  printf '\n%sModèles%s\n' "$C_CYAN" "$C_OFF"
  py modele liste 2>/dev/null | sed 's/^/  /' || true
  if py modele liste 2>/dev/null | grep -q "pas encore essayé"; then
    warn "des modèles n'ont pas encore été essayés : jarvis modele verifier (le démon le fait aussi tout seul)"
  fi

  printf '\n%sStudio (vidéo)%s\n' "$C_CYAN" "$C_OFF"
  if has ffmpeg && has ffprobe; then ok "ffmpeg présent"; else warn "ffmpeg manquant : ./install.sh --studio"; fi
  if node -e 'require("playwright")' >/dev/null 2>&1 \
     || NODE_PATH="$(npm root -g 2>/dev/null)" node -e 'require("playwright")' >/dev/null 2>&1; then
    ok "Playwright présent (enregistrement et rendu des scènes)"
  else
    warn "Playwright manquant : ./install.sh --studio"
  fi

  printf '\n%sPoste%s\n' "$C_CYAN" "$C_OFF"
  py sante 2>/dev/null | sed 's/^/  /' || true
  if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then cmd_autostart etat || true; fi

  printf '\n%sSession%s\n' "$C_CYAN" "$C_OFF"
  if has tmux && tmux has-session -t "$SESSION" 2>/dev/null; then
    ok "Session « $SESSION » active"
    local wins
    wins="$(tmux list-windows -t "$SESSION" -F '#{window_name}')"
    grep -qx daemon <<<"$wins" && ok "démon actif" || warn "démon arrêté (jarvis start le relance)"
    grep -qx chef <<<"$wins" && ok "chef actif" || warn "chef arrêté (jarvis chef)"
  else
    warn "Session « $SESSION » fermée (jarvis start)"
  fi

  echo
  if ((errors)); then bad "$errors problème(s) bloquant(s). Relance ./install.sh"; return 1; fi
  ok "Prêt à piloter."
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    start)        cmd_start "$@" ;;
    chef)         cmd_chef "$@" ;;
    task|t)       cmd_task "$@" ;;
    cockpit|etat|plan|fil|projet|telegram|regler|capacite|demander|note|journal|daemon|voir|jetons|veille|\
    fermer|reprendre|sante|reparer-git|role|modele|tache|verdict|bilan|usine|studio|livrer|livrables|web|\
    admission|pause|profil|lourd|audit|diagnostic|politique|budget|fournisseurs|proposition|\
    budget-jetons|cout|memoire|secrets|eval|rejouer|traces|proxy|rollback|execution|skill|stockage|executant)
                  py "$cmd" "$@" ;;
    chef-lancer)  cmd_chef_lancer "$@" ;;
    relancer)     cmd_relancer "$@" ;;
    board|b)      cmd_board "$@" ;;
    status|s|ls)  cmd_status "$@" ;;
    init-project) cmd_init_project "$@" ;;
    doctor)       cmd_doctor "$@" ;;
    autostart)    cmd_autostart "$@" ;;
    help|-h|--help) usage ;;
    *) usage; die "commande inconnue : $cmd" ;;
  esac
}

main "$@"
